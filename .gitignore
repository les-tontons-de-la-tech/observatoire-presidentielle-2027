data/polls.json
data/polls2022.json
data/forecast_bayes.json

# Scrutins de l'Assemblée nationale — ~26 Mo par législature, rechargés chaque semaine.
data/lois/

# Pages générées — le dépôt porte le générateur, pas son résultat.
# Elles se régénèrent à l'identique avec : python3 generate.py && python3 candidats.py && python3 backtest2022.py
site/

# Divers
__pycache__/
*.pyc
*.bak
*.bak-*
.DS_Store
